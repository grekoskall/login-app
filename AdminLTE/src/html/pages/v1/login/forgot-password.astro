---
import Head from '@components/_head.astro'
import Scripts from '@components/_scripts.astro'

import ForgotPasswordForm from '@components/react/forgotPassword/ForgotPasswordForm'

const title = 'Login App | Forgot Password'
const path = '../../../dist'
---

<!doctype html>
<html lang='en'>
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class='login-page bg-body-secondary'>
    <div class='login-box'>
      <div class='card card-outline card-primary'>
        <div class='card-header mt-2'>
          <p class='login-box-msg p-0 mb-2 fs-4'>Forgot Password</p>
        </div>
        <div class='card-body login-card-body'>
          <p class='mb-4 text-center'>
            Enter your <span class='fw-b'>email</span> and we will send you a link
            you can use to reset your password.
          </p>
          <ForgotPasswordForm client:only='react' />
        </div>
        <!-- /.login-card-body -->
      </div>
    </div>
    <!-- /.login-box -->

    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Body-->
</html>
